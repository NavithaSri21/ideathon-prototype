{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile data",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User UID from Firebase Auth"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user"
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL to the user avatar"
        },
        "institution": {
          "type": "string",
          "description": "College, university, or educational institution"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["uid", "email"]
    },
    "CareerAnalysis": {
      "title": "CareerAnalysis",
      "description": "AI career diagnostic report for a student",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique analysis ID"
        },
        "userId": {
          "type": "string",
          "description": "UID of the owner user"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the analysis generation"
        },
        "jobReadinessScore": {
          "type": "number",
          "description": "Overall job readiness score (0-100)"
        },
        "readinessLevel": {
          "type": "string",
          "description": "Readiness tier"
        },
        "readinessSummary": {
          "type": "string",
          "description": "Executive summary of diagnostic findings"
        }
      },
      "required": ["id", "userId", "jobReadinessScore"]
    },
    "LearningRoadmap": {
      "title": "LearningRoadmap",
      "description": "Personalized 30-day learning curriculum roadmap",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Roadmap document ID (typically the userId or generated ID)"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user owner"
        },
        "targetRole": {
          "type": "string",
          "description": "Target job title / specialization"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        },
        "summary": {
          "type": "string",
          "description": "Roadmap overview description"
        },
        "totalHours": {
          "type": "number",
          "description": "Total estimated hours"
        },
        "progressPercent": {
          "type": "number",
          "description": "Completion percentage (0-100)"
        }
      },
      "required": ["id", "userId", "targetRole"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Store individual student profile information indexed by user Auth UID"
    },
    "/careerAnalyses/{analysisId}": {
      "schema": "CareerAnalysis",
      "description": "Stores career readiness diagnostic results tied to a specific userId"
    },
    "/roadmaps/{roadmapId}": {
      "schema": "LearningRoadmap",
      "description": "Stores user 30-day action roadmaps and completion progress tied to userId"
    }
  }
}
